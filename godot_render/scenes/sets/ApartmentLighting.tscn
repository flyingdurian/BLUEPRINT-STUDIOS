; M4E-D look-dev apartment lighting. Provisional numbers, not an approved final look.
; This scene is separate from the M4-B proof main scene.
[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ApartmentLightingController.gd" id="1_light"]
[ext_resource type="PackedScene" path="res://actors/lead/ActorLead.tscn" id="2_actor"]

[node name="ProductionRenderRoot" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]

[node name="LightingRig" type="Node3D" parent="."]
script = ExtResource("1_light")

[node name="WindowKey" type="DirectionalLight3D" parent="LightingRig"]
shadow_enabled = true

[node name="FaceFill" type="OmniLight3D" parent="LightingRig"]
shadow_enabled = false

[node name="RimAccent" type="SpotLight3D" parent="LightingRig"]
shadow_enabled = false

[node name="ActiveSet" type="Node3D" parent="."]

[node name="Actor_Lead" parent="." instance=ExtResource("2_actor")]

[node name="CameraRig" type="Node3D" parent="."]

[node name="Camera3D" type="Camera3D" parent="CameraRig"]
current = true
